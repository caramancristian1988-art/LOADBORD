{
  "name": "loadboard-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "prisma generate && node scripts/db-sync.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-mongo.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  },
  "engines": {
    "node": ">=20.9"
  }
}
