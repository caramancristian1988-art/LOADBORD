# MongoDB connection (must be a replica set — Prisma uses transactions).
# Local dev: `npm run dev` starts a bundled single-node replica set on port 27027.
DATABASE_URL="mongodb://127.0.0.1:27027/loadboard?replicaSet=rs0&directConnection=true"

# MongoDB Atlas example:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/loadboard?retryWrites=true&w=majority"
